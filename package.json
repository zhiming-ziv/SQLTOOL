{
  "name": "sqltool",
  "version": "1.0.0",
  "private": true,
  "description": "浏览器内数据库工作台 — 支持 SQLite(内置) / MySQL / PostgreSQL / SQL Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:engine": "node tools/cdp-run.js http://127.0.0.1:8777/app/selftest.html __selftest",
    "test:api": "node tools/api-test.js",
    "test:ui": "node tools/ui-test.js http://127.0.0.1:8777",
    "test:templates": "node tools/template-test.js"
  },
  "dependencies": {
    "mysql2": "^3.11.5",
